{
  "name": "@termterm/desktop",
  "productName": "termterm",
  "version": "0.1.0",
  "private": true,
  "description": "SSH client with an end-to-end encrypted, synced vault",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "electron-vite build && node e2e/smoke.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "screenshots": "electron-vite build && node e2e/screenshots.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.63.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "dev.termterm.app",
    "productName": "termterm",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "artifactName": "termterm-${version}-${arch}.${ext}"
    },
    "artifactName": "termterm-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "termterm-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "termterm-${version}-portable.${ext}"
    },
    "executableName": "termterm",
    "publish": [
      {
        "provider": "github",
        "owner": "deanbirnie",
        "repo": "termterm",
        "releaseType": "release"
      }
    ]
  },
  "author": "termterm",
  "repository": {
    "type": "git",
    "url": "https://github.com/deanbirnie/termterm.git"
  }
}
